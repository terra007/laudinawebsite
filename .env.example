# Als .env.local kopieren und ausfüllen. Ohne diese Werte senden das
# Kontaktformular und das Stammdatenblatt keine E-Mails; die Seite bietet
# dann E-Mail, Telefon bzw. den PDF-Download an.

# SMTP-Postfach, über das die Website sendet
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Empfängerin der Formulare
MAIL_TO=praxis@pongracz-psychotherapie.com

# Absender (leer lassen = SMTP_USER)
MAIL_FROM=
